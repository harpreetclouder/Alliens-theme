{
  "name": "orbital",
  "displayName": "Orbital",
  "description": "Alien/UFO theme and celebration companion for Cursor/VS Code",
  "version": "0.0.33",
  "publisher": "orbital",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Orbital — Mothership OS",
        "uiTheme": "vs-dark",
        "path": "./themes/mothership-color-theme.json"
      },
      {
        "label": "Orbital — Glitch Transmission",
        "uiTheme": "vs-dark",
        "path": "./themes/glitch-color-theme.json"
      },
      {
        "label": "Orbital — Soft Abduction",
        "uiTheme": "vs-dark",
        "path": "./themes/soft-abduction-color-theme.json"
      },
      {
        "label": "Orbital — Root Access",
        "uiTheme": "vs-dark",
        "path": "./themes/root-access-color-theme.json"
      },
      {
        "label": "Orbital — Acid Scrapbook",
        "uiTheme": "vs-dark",
        "path": "./themes/acid-scrapbook-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "orbital.switchPack",
        "title": "Orbital: Switch Pack"
      },
      {
        "command": "orbital.previewCelebration",
        "title": "Orbital: Preview Celebration"
      },
      {
        "command": "orbital.toggleSound",
        "title": "Orbital: Toggle Sound"
      },
      {
        "command": "orbital.previewCommitCelebration",
        "title": "Orbital: Preview Commit Celebration"
      },
      {
        "command": "orbital.openPanel",
        "title": "Orbital: Open Celebration Panel"
      },
      {
        "command": "orbital.verifyCelebrations",
        "title": "Orbital: Verify Celebrations"
      },
      {
        "command": "orbital.setup",
        "title": "Orbital: Setup Wizard"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "orbital-panel",
          "title": "Orbital",
          "icon": "media/orbital-icon.svg"
        }
      ]
    },
    "views": {
      "orbital-panel": [
        {
          "type": "webview",
          "id": "orbital.celebrationView",
          "name": "Celebration"
        }
      ]
    },
    "configuration": {
      "title": "Orbital",
      "properties": {
        "orbital.pack": {
          "type": "string",
          "enum": [
            "mothership",
            "glitch",
            "soft",
            "root",
            "acid"
          ],
          "default": "mothership",
          "description": "Active celebration pack and theme family"
        },
        "orbital.celebrations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable celebrations on dev wins"
        },
        "orbital.orbit.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Track XP, streaks, achievements, and daily missions (Orbital Orbit)"
        },
        "orbital.celebrations.display": {
          "type": "string",
          "enum": [
            "terminal",
            "panel",
            "overlay"
          ],
          "default": "terminal",
          "description": "Fallback for commit/build/debug wins: panel (bottom tab) or overlay (fullscreen tab). Tests always use the integrated terminal."
        },
        "orbital.celebrations.surfaces": {
          "type": "object",
          "default": {},
          "description": "Per-trigger surface overrides (terminal | panel | overlay | statusbar). Unset triggers use built-in defaults.",
          "properties": {
            "tests": {
              "type": "string",
              "enum": [
                "terminal",
                "panel",
                "overlay",
                "statusbar"
              ]
            },
            "build": {
              "type": "string",
              "enum": [
                "terminal",
                "panel",
                "overlay",
                "statusbar"
              ]
            },
            "commit": {
              "type": "string",
              "enum": [
                "terminal",
                "panel",
                "overlay",
                "statusbar"
              ]
            },
            "debug": {
              "type": "string",
              "enum": [
                "terminal",
                "panel",
                "overlay",
                "statusbar"
              ]
            },
            "save": {
              "type": "string",
              "enum": [
                "terminal",
                "panel",
                "overlay",
                "statusbar"
              ]
            },
            "preview": {
              "type": "string",
              "enum": [
                "terminal",
                "panel",
                "overlay",
                "statusbar"
              ]
            }
          }
        },
        "orbital.celebrations.intensity": {
          "type": "string",
          "enum": [
            "chill",
            "normal",
            "hype"
          ],
          "default": "normal",
          "description": "chill = status bar whispers; normal = terminal tests + panel commits; hype = animated terminal + overlay on big wins"
        },
        "orbital.celebrations.triggers.tests": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate when tests pass"
        },
        "orbital.celebrations.triggers.build": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate on successful build"
        },
        "orbital.celebrations.triggers.commit": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate on commit"
        },
        "orbital.celebrations.triggers.debug": {
          "type": "boolean",
          "default": true,
          "description": "Celebrate when a debug session ends"
        },
        "orbital.celebrations.triggers.save": {
          "type": "boolean",
          "default": false,
          "description": "Celebrate on file save"
        },
        "orbital.sound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Play pack SFX during celebrations"
        },
        "orbital.sound.mutedPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mothership",
              "glitch",
              "soft",
              "root",
              "acid"
            ]
          },
          "default": [],
          "description": "Packs whose SFX are muted"
        },
        "orbital.reduceMotion": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "Reduce celebration motion (auto follows OS)"
        },
        "orbital.joy.region": {
          "type": "string",
          "default": "auto",
          "description": "Meme/GIF region bias: auto (from editor language + timezone) or us|uk|in|br|jp|kr|de|fr|es|mx|au|global. Never uses GPS."
        },
        "orbital.giphy.sdkKey": {
          "type": "string",
          "default": "",
          "description": "Giphy SDK/API key (full access when upgraded to Production). Create at https://developers.giphy.com/dashboard/ → Create App → choose SDK (recommended) or API → copy key. For higher rate limits click Upgrade to Production. Required for live international GIFs."
        },
        "orbital.giphy.apiKey": {
          "type": "string",
          "default": "",
          "description": "Deprecated alias — use orbital.giphy.sdkKey. Same Giphy dashboard key.",
          "deprecationMessage": "Use orbital.giphy.sdkKey instead."
        },
        "orbital.tenor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Deprecated — Tenor API shut down June 2026. Use orbital.giphy.sdkKey.",
          "deprecationMessage": "Use orbital.giphy.sdkKey instead. Tenor API was discontinued."
        }
      }
    }
  },
  "scripts": {
    "build:scene": "node scripts/build-scene.mjs",
    "compile": "npm run build:scene && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "posttest": "node scripts/signal-test-pass.mjs",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "verify:agent": "node scripts/verify-agent.mjs",
    "verify:commit-detect": "node scripts/verify-commit-detect.mjs",
    "verify:commit-live": "node scripts/verify-commit-live.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "eval": "npm run compile && node scripts/eval.mjs",
    "generate:sfx": "node scripts/generate-sfx.mjs",
    "generate:acid-gifs": "node scripts/generate-acid-gifs.mjs",
    "generate:bites": "node scripts/expand-bites.mjs",
    "vscode:prepublish": "npm run compile"
  },
  "keywords": [
    "theme",
    "celebration",
    "ufo",
    "alien",
    "cursor",
    "vscode"
  ],
  "author": "Orbital",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/three": "^0.170.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
}
