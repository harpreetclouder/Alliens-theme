{
  "name": "Orbital — Acid Scrapbook",
  "type": "dark",
  "colors": {
    "editor.background": "#0c0a0f",
    "editor.foreground": "#fff6e8",
    "editor.selectionBackground": "#d6ff3c33",
    "editor.lineHighlightBackground": "#ffffff08",
    "editorCursor.foreground": "#d6ff3c",
    "editor.findMatchBackground": "#ff2d9544",
    "editor.findMatchHighlightBackground": "#d6ff3c28",
    "editorWidget.background": "#141018",
    "editorWidget.border": "#d6ff3c55",
    "activityBar.background": "#0c0a0f",
    "activityBar.foreground": "#fff6e8",
    "activityBar.activeBorder": "#d6ff3c",
    "activityBarBadge.background": "#ff2d95",
    "activityBarBadge.foreground": "#fff6e8",
    "sideBar.background": "#0c0a0f",
    "sideBar.foreground": "#fff6e8",
    "sideBar.border": "#ffffff10",
    "sideBarTitle.foreground": "#d6ff3c",
    "statusBar.background": "#ff2d95",
    "statusBar.foreground": "#fff6e8",
    "statusBar.noFolderBackground": "#ff2d95",
    "statusBarItem.remoteBackground": "#d6ff3c",
    "statusBarItem.remoteForeground": "#0c0a0f",
    "titleBar.activeBackground": "#0c0a0f",
    "titleBar.activeForeground": "#fff6e8",
    "titleBar.inactiveBackground": "#0c0a0f",
    "tab.activeBackground": "#141018",
    "tab.activeForeground": "#fff6e8",
    "tab.activeBorderTop": "#d6ff3c",
    "tab.inactiveBackground": "#0c0a0f",
    "tab.inactiveForeground": "#6b6570",
    "focusBorder": "#d6ff3c",
    "button.background": "#d6ff3c",
    "button.foreground": "#0c0a0f",
    "button.hoverBackground": "#e8ff6a",
    "input.background": "#141018",
    "input.border": "#d6ff3c44",
    "input.foreground": "#fff6e8",
    "list.activeSelectionBackground": "#d6ff3c28",
    "list.activeSelectionForeground": "#fff6e8",
    "list.hoverBackground": "#ffffff0c",
    "scrollbarSlider.background": "#d6ff3c33",
    "terminal.background": "#0c0a0f",
    "terminal.foreground": "#fff6e8",
    "terminal.ansiGreen": "#d6ff3c",
    "terminal.ansiMagenta": "#ff2d95",
    "terminal.ansiCyan": "#5ef2ff",
    "panel.background": "#0c0a0f",
    "panel.border": "#ff2d9544",
    "badge.background": "#ff2d95",
    "badge.foreground": "#fff6e8",
    "progressBar.background": "#d6ff3c"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b6570", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#d6ff3c" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#ff2d95" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#5ef2ff" } },
    { "scope": ["variable", "entity.name.variable"], "settings": { "foreground": "#fff6e8" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#ffe56b" } },
    { "scope": ["entity.name.type", "support.type", "support.class"], "settings": { "foreground": "#b8a0ff" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#a89fa8" } }
  ]
}
